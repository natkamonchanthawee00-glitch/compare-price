            </div>

        </div>


        <div class="spec-area">

            <b>
                ⚙️ สเปกสินค้า
            </b>

            <div
                id="specList-${id}">
            </div>

            <button
                class="add-spec"
                onclick="addSpec(${id})">

                ➕ เพิ่มสเปก

            </button>

        </div>

    `;


    document
        .getElementById("productList")
        .appendChild(product);


    /* สร้างสเปกเริ่มต้น 2 ช่อง */

    addSpec(id);

    addSpec(id);

}


/* ==========================
   ลบสินค้า
========================== */

function removeProduct(id) {

    var product =
        document.getElementById(
            "product-" + id
        );

    if(product) {

        product.remove();

    }

}


