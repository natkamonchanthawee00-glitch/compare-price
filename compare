<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Compare Smart</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    color: #1e293b;
}

header {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    text-align: center;
    padding: 35px 15px;
}

header h1 {
    margin: 0 0 10px;
}

.container {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
}

.card {
    background: white;
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 5px 18px rgba(0,0,0,.08);
}

.product {
    border: 2px solid #e2e8f0;
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 18px;
    background: #f8fafc;
}

.product-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.product-top h3 {
    margin: 0;
    color: #2563eb;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

label {
    display: block;
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 5px;
}

input,
select {
    width: 100%;
    padding: 11px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 15px;
    background: white;
}

button {
    border: 0;
    border-radius: 9px;
    padding: 11px 16px;
    font-weight: bold;
    cursor: pointer;
}

.add-product {
    background: #16a34a;
    color: white;
}

.remove-product {
    background: #ef4444;
    color: white;
}

.compare-button {
    width: 100%;
    margin-top: 15px;
    background: #2563eb;
    color: white;
    font-size: 18px;
    padding: 15px;
}

.spec-area {
    margin-top: 20px;
    border-top: 1px solid #ddd;
    padding-top: 15px;
}

.spec {
    background: white;
    border: 1px solid #ddd;
    padding: 12px;
    border-radius: 10px;
    margin-top: 10px;
}

.spec-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr auto;
    gap: 8px;
    align-items: end;
}

.add-spec {
    background: #7c3aed;
    color: white;
    margin-top: 10px;
}

.remove-spec {
    background: #ef4444;
    color: white;
    padding: 9px;
}

.results {
    display: none;
}

.winner {
    background: #dcfce7;
    border: 2px solid #22c55e;
    border-radius: 12px;
    text-align: center;
    padding: 20px;
    margin-bottom: 20px;
}

.result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 15px;
}

.result {
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    padding: 15px;
}

.result.best {
    border-color: #22c55e;
}

.result img {
    width: 100%;
    height: 160px;
    object-fit: contain;
    background: #f1f5f9;
    border-radius: 8px;
}

.score {
    font-size: 25px;
    font-weight: bold;
    color: #16a34a;
}

.price {
    color: #2563eb;
    font-weight: bold;
    font-size: 20px;
}

.view {
    display: block;
    background: #111827;
    color: white;
    text-decoration: none;
    text-align: center;
    padding: 10px;
    border-radius: 8px;
    margin-top: 10px;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

th,
td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
}

th {
    background: #eef2ff;
}

.best-cell {
    background: #dcfce7;
    font-weight: bold;
}

@media(max-width:700px) {

    .grid {
        grid-template-columns: 1fr;
    }

    .spec-grid {
        grid-template-columns: 1fr;
    }

}
</style>
</head>

