<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Compare Smart</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f3f4f6;
    color: #222;
}

header {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    text-align: center;
    padding: 30px 15px;
}

header h1 {
    margin: 0 0 8px;
}

.container {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 15px;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
}

.product {
    background: #f8fafc;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 20px;
}

.product-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.product-head h3 {
    margin: 0;
    color: #2563eb;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

label {
    display: block;
    font-weight: bold;
    margin-bottom: 5px;
}

input,
select {
    width: 100%;
    padding: 11px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 15px;
}

button {
    border: 0;
    border-radius: 8px;
    padding: 11px 15px;
    cursor: pointer;
    font-weight: bold;
}

.add-product {
    background: #16a34a;
    color: white;
}

.delete-product {
    background: #ef4444;
    color: white;
}

.add-spec {
    background: #7c3aed;
    color: white;
    margin-top: 12px;
}

.delete-spec {
    background: #ef4444;
    color: white;
}

.compare {
    display: block;
    width: 100%;
    margin-top: 15px;
    padding: 15px;
    background: #2563eb;
    color: white;
    font-size: 18px;
}

.spec-box {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #ddd;
}

.spec {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 12px;
    margin-top: 10px;
}

.spec-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr auto;
    gap: 8px;
    align-items: end;
}

.results {
    display: none;
}

.winner {
    background: #dcfce7;
    border: 2px solid #22c55e;
    padding: 20px;
    border-radius: 12px;
    text-align: center;
}

.result-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 15px;
    margin-top: 20px;
}

.result {
    border: 2px solid #ddd;
    border-radius: 12px;
    padding: 15px;
}

.result.best {
    border-color: #22c55e;
}

.result img {
    width: 100%;
    height: 160px;
    object-fit: contain;
    background: #f3f4f6;
    border-radius: 8px;
}

.score {
    color: #16a34a;
    font-size: 24px;
    font-weight: bold;
}

.price {
    color: #2563eb;
    font-size: 20px;
    font-weight: bold;
}

.link-button {
    display: block;
    text-align: center;
    background: #111827;
    color: white;
    text-decoration: none;
    padding: 10px;
    border-radius: 8px;
    margin-top: 10px;
}

.table-wrap {
    overflow-x: auto;
    margin-top: 20px;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
}

th,
td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
}

th {
    background: #eef2ff;
}

@media (max-width: 700px) {

    .grid {
        grid-template-columns: 1fr;
    }

    .spec-grid {
        grid-template-columns: 1fr;
    }

}

</style>
</head>


<body>

<header>

<h1>🛒 Compare Smart</h1>

<p>
คำนวณและเปรียบเทียบความคุ้มค่าสินค้า
</p>

</header>


<div class="container">


<div class="card">

<h2>📦 รายการสินค้า</h2>

<p>
เพิ่มสินค้า กำหนดสเปก และเปรียบเทียบความคุ้มค่า
</p>

<div id="productList"></div>


<button
type="button"
class="add-product"
id="addProductButton">

➕ เพิ่มสินค้า

</button>


<button
type="button"
class="compare"
id="compareButton">

🔍 เปรียบเทียบความคุ้มค่า

</button>

</div>


<div
class="card results"
id="results">

<div
class="winner"
id="winner">
</div>


<h2>📊 ผลการเปรียบเทียบ</h2>

<div
class="result-list"
id="resultList">
</div>


<h2>⚙️ ตารางเปรียบเทียบสเปก</h2>

<div class="table-wrap">

<table id="comparisonTable">

</table>

</div>

</div>


</div>


<script>

/* =================================
   ตัวแปร
================================= */

let productNumber = 0;


/* =================================
   ปุ่มเพิ่มสินค้า
================================= */

document
.getElementById("addProductButton")
.addEventListener("click", function() {

    addProduct();

});


/* =================================
   ปุ่มเปรียบเทียบ
================================= */

document
.getElementById("compareButton")
.addEventListener("click", function() {

    compareProducts();

});


/* =================================
   เพิ่มสินค้า
================================= */

function addProduct() {

    productNumber++;

    const id = productNumber;

    const product =
        document.createElement("div");

    product.className = "product";

    product.dataset.id = id;


    product.innerHTML = `

        <div class="product-head">

            <h3>
                📦 สินค้า ${id}
            </h3>

            <button
                type="button"
                class="delete-product">

                🗑 ลบ

            </button>

        </div>


        <div class="grid">

            <div>

                <label>
                    ประเภทสินค้า
                </label>

                <select class="category">

                    <option>
                        ของใช้ทั่วไป
                    </option>

                    <option>
                        คอมพิวเตอร์
                    </option>

                    <option>
                        โทรศัพท์
                    </option>

                    <option>
                        แท็บเล็ต
                    </option>

                    <option>
                        อุปกรณ์ไอที
                    </option>

                    <option>
                        เครื่องใช้ไฟฟ้า
                    </option>

                    <option>
                        อื่น ๆ
                    </option>

                </select>

            </div>


            <div>

                <label>
                    ชื่อสินค้า
                </label>

                <input
                    class="product-name"
                    placeholder="เช่น Laptop ASUS">

            </div>


            <div>

                <label>
                    ราคา (บาท)
                </label>

                <input
                    class="product-price"
                    type="number"
                    min="0"
                    placeholder="เช่น 19900">

            </div>


            <div>

                <label>
                    จำนวน
                </label>

                <input
                    class="product-quantity"
                    type="number"
                    min="0"
                    step="0.01"
                    placeholder="เช่น 1">

            </div>


            <div>

                <label>
                    หน่วย
                </label>

                <input
                    class="product-unit"
                    placeholder="เครื่อง / ชิ้น / ml">

            </div>


            <div>

                <label>
                    ลิงก์สินค้า
                </label>

                <input
                    class="product-link"
                    type="url"
                    placeholder="https://...">

            </div>


            <div>

                <label>
                    ลิงก์รูปภาพ
                </label>

                <input
                    class="product-image"
                    type="url"
                    placeholder="https://...jpg">

            </div>

        </div>


        <div class="spec-box">

            <h4>
                ⚙️ กำหนดสเปก
            </h4>


            <div class="spec-list">

            </div>


            <button
                type="button"
                class="add-spec">

                ➕ เพิ่มสเปก

            </button>

        </div>

    `;


    document
    .getElementById("productList")
    .appendChild(product);


    /* ปุ่มลบสินค้า */

    product
    .querySelector(".delete-product")
    .addEventListener("click", function() {

        product.remove();

    });


    /* ปุ่มเพิ่มสเปก */

    product
    .querySelector(".add-spec")
    .addEventListener("click", function() {

        addSpec(product);

    });


    /* เพิ่มสเปกเริ่มต้น 2 ช่อง */

    addSpec(product);

    addSpec(product);

}


/* =================================
   เพิ่มสเปก
================================= */

function addSpec(product) {

    const list =
        product.querySelector(".spec-list");


    const spec =
        document.createElement("div");

    spec.className = "spec";


    spec.innerHTML = `

        <div class="spec-grid">

            <div>

                <label>
                    ชื่อสเปก
                </label>

                <input
                    class="spec-name"
                    placeholder="เช่น RAM">

            </div>


            <div>

                <label>
                    ค่า
                </label>

                <input
                    class="spec-value"
                    placeholder="เช่น 16">

            </div>


            <div>

                <label>
                    หน่วย
                </label>

                <input
                    class="spec-unit"
                    placeholder="GB">

            </div>


            <div>

                <label>
                    การให้คะแนน
                </label>

                <select class="spec-type">

                    <option value="high">
                        มาก = ดี
                    </option>

                    <option value="low">
